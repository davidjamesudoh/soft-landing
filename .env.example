# Copy this file to .env (in the repo root) and fill in real values.
# The Airtable credentials can be the same ones already in your .env.local.

AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=RSVPs

# Optional: only fetch guests from this Airtable view instead of the whole table.
# AIRTABLE_VIEW_NAME=

# Field names — defaults match the existing RSVP form. Override if your
# Airtable columns are named differently.
# NAME_FIELD=Name
# PHONE_FIELD=Phone number
# ATTENDING_FIELD=Attending
# ATTENDING_YES_VALUE=Yes! Wouldn’t miss it for anything
# CARD_SENT_FIELD=Card Sent
# TABLE_NUMBER_FIELD=Table Number

# Optional: path to the real card template PNG once you have one.
# CARD_TEMPLATE_PATH=./scripts/assets/card-template.png

# Optional: delay range (ms) between WhatsApp sends.
# MIN_DELAY_MS=3000
# MAX_DELAY_MS=8000

# The WhatsApp number that will actually send the invites. If this belongs
# to someone else (e.g. a friend), set it here — login then uses a pairing
# code you can text them, instead of a QR code you'd have to scan yourself.
# WHATSAPP_SENDER_PHONE=+2348012345678

# --- Admin dashboard (app/dashboard/admin) ---
ADMIN_EMAIL=
# Base64 of a bcrypt hash — NOT the plain hash. Plain "$2b$12$..." hashes
# get corrupted by Next.js's .env "$VAR" interpolation. Generate with:
#   node -e 'const b=require("bcryptjs");const h=b.hashSync("yourpassword",12);console.log(Buffer.from(h).toString("base64"))'
ADMIN_PASSWORD_HASH_B64=
# Random secret used to sign session cookies. Generate with:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
DASHBOARD_SESSION_SECRET=
